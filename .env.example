# Reddit Conversions API (server-side / CAPI) — used by /api/reddit-capi.js
#
# These are SERVER-SIDE secrets. Do NOT prefix with VITE_ (that would expose
# them to the browser) and do NOT commit real values. Set them in the Vercel
# project: Settings -> Environment Variables, or `vercel env add`.

# Long-lived Conversions Access Token from Reddit Ads -> Events Manager -> Conversions API
REDDIT_CONVERSION_TOKEN=

# Reddit ad account id (the `aid` claim in the token). Optional — defaults to
# t2_2fqfj9z7g7 in code if unset.
REDDIT_CONVERSION_ACCOUNT_ID=t2_2fqfj9z7g7

# PostHog product analytics.
#
# The project token is a PUBLIC, client-side key (safe to expose in the browser
# bundle). The VITE_ prefix exposes it to the frontend build. Code falls back to
# a baked-in default if these are unset, so setting them is optional but
# recommended (lets you swap the project without a code change).
VITE_PUBLIC_POSTHOG_KEY=phc_saLqpV3uLmLXEqprdnXTpoFKyMp5hcZEnPXkYajpwzSk
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side (Vercel Functions) — used by /api/reddit-capi.js to mirror leads.
# Same project token; NOT VITE_ prefixed so it stays server-only.
POSTHOG_KEY=phc_saLqpV3uLmLXEqprdnXTpoFKyMp5hcZEnPXkYajpwzSk
POSTHOG_HOST=https://us.i.posthog.com
