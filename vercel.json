{
  "redirects": [
    {
      "source": "/thank-you-from-finanshels",
      "destination": "/thank-you",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/quote/:path*",
      "destination": "https://fincore.finanshels.com/api/pricing/public/:path*"
    },
    {
      "source": "/api/quote-session",
      "destination": "https://fincore.finanshels.com/api/wizard/session"
    },
    {
      "source": "/api/quote-proposal",
      "destination": "https://fincore.finanshels.com/api/quotes/public"
    },
    {
      "source": "/((?!api/|sitemap\\.xml$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
