{
  "redirects": [
    {
      "source": "/thank-you-from-finanshels",
      "destination": "/thank-you",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|sitemap\\.xml$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
